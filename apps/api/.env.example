# Server
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Database
# Embedded PGlite, persisted to packages/database/.data/pglite — no server needed.
# Point at a real server with postgresql://user:pass@host:5432/opsora instead.
DATABASE_URL=file:./.data/pglite

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
