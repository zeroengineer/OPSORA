{
  "name": "@opsora/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/swagger": "1.3.1",
    "@opsora/auth": "workspace:*",
    "@opsora/config": "workspace:*",
    "@opsora/database": "workspace:*",
    "@opsora/types": "workspace:*",
    "@opsora/utils": "workspace:*",
    "elysia": "1.4.29"
  },
  "devDependencies": {
    "@opsora/eslint-config": "workspace:*",
    "@opsora/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "eslint": "10.8.1",
    "typescript": "6.0.3"
  }
}
