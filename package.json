{
  "name": "opsora",
  "private": true,
  "version": "0.1.0",
  "description": "OPSORA — business management platform",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@opsora/web",
    "dev:api": "turbo run dev --filter=@opsora/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "db:studio": "turbo run db:studio",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "turbo": "2.10.11",
    "typescript": "6.0.3"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
