# ---------------------------------------------------------------------------
# OPSORA — reference environment file
#
# This root file documents every variable used across the monorepo.
# Each app loads its OWN scoped .env file at runtime:
#
#   apps/web/.env  ->  VITE_API_URL, VITE_APP_URL
#   apps/api/.env  ->  DATABASE_URL, BETTER_AUTH_*, R2_*, PORT, WEB_ORIGIN
#
# Copy the scoped examples instead of this one:
#   cp apps/web/.env.example apps/web/.env
#   cp apps/api/.env.example apps/api/.env
# ---------------------------------------------------------------------------

# Application (apps/web)
VITE_API_URL=http://localhost:3000
VITE_APP_URL=http://localhost:5173

# Database (apps/api, packages/database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opsora

# Better Auth (apps/api)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2 (apps/api)
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# Server (apps/api)
PORT=3000
WEB_ORIGIN=http://localhost:5173
